{
  "name": "image-watermark",
  "version": "1.4.1",
  "private": true,
  "description": "Browser-based image toolkit for batch watermarking, compression, and EXIF metadata editing.",
  "keywords": [
    "watermark",
    "image-processing",
    "image-compression",
    "exif",
    "metadata",
    "privacy",
    "local-first",
    "nextjs",
    "fabricjs",
    "typescript",
    "batch-processing",
    "canvas",
    "image-editor"
  ],
  "author": "xyh9949",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xyh9949/image-watermark.git"
  },
  "bugs": {
    "url": "https://github.com/xyh9949/image-watermark/issues"
  },
  "homepage": "https://github.com/xyh9949/image-watermark#readme",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "smoke:html": "node scripts/smoke-html.mjs",
    "test:metadata": "node --test scripts/test-metadata.mjs",
    "verify": "npm run type-check && npm run lint && npm run test:metadata && npm run build && npm run smoke:html"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@uswriting/exiftool": "^1.0.9",
    "antd": "^6.6.6",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.539.0",
    "next": "^16.3.8",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  }
}
